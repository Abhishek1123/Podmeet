rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function superAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && (
          request.auth.token.email.lower() == 'abhichatterjee90@gmail.com'
        );
    }

    // Any authenticated Google user who passed the server-side invite session
    function invited() {
      return superAdmin() || (
        request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
      );
    }

    match /rooms/{roomId} {
      allow read, write: if invited();
      match /{document=**} {
        allow read, write: if invited();
      }
    }
    match /recordings/{recordingId} {
      allow read, write: if invited();
    }
    // Authenticated users can read the roster (for invitation verification & member display);
    // only the super admin can create/update/delete members.
    match /members/{memberId} {
      allow read: if request.auth != null;
      allow write: if superAdmin();
    }
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
